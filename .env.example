MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=fingerprint_db
MATCH_THRESHOLD=45.0

# SecuGen Scanner Configuration
# SECUGEN_LIC: Leave empty for evaluation mode with demo/trial scanners
# For production scanners, obtain license from SecuGen and set this value
# Format: SECUGEN_LIC=your_license_string_here
SECUGEN_LIC=
