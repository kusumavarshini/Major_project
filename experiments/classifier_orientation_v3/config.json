{
  "experiment_name": "classifier_orientation_v3",
  "description": "Domain-adapted FingerprintCNN distortion classifier with symmetric photometric adaptation and asymmetric capture simulation",
  "model": {
    "architecture": "FingerprintCNN",
    "in_channels": 1,
    "image_size": 224,
    "dropout": 0.5,
    "num_classes": 1,
    "param_count_expected": 389057
  },
  "dataset": {
    "dataset_root": "data/orientation_capture_variations_v1",
    "clean_dir": "clean",
    "orientation_dir": "orientation_variation",
    "partial_dir": "partial_capture",
    "uneven_dir": "uneven_contact",
    "split_manifest_dir": "experiments/classifier_orientation_v3/splits",
    "splits": {
      "train_ratio": 0.70,
      "val_ratio": 0.15,
      "test_ratio": 0.15
    },
    "seed": 42
  },
  "classes": {
    "clean": 0,
    "distorted": 1,
    "distorted_components": [
      "orientation_variation",
      "partial_capture",
      "uneven_contact"
    ]
  },
  "preprocessing": {
    "target_size": [224, 224],
    "channels": 1,
    "dtype": "float32",
    "grayscale": true,
    "normalization": "scale_0_1",
    "interpolation": "INTER_AREA"
  },
  "domain_adaptation_augmentations": {
    "symmetric_photometric": {
      "enabled": true,
      "probability": 0.60,
      "tir_ridge_darkening": {
        "enabled": true,
        "gamma_min": 1.3,
        "gamma_max": 2.2,
        "target_ridge_intensity_min": 10,
        "target_ridge_intensity_max": 30
      },
      "laplacian_sharpness_boost": {
        "enabled": true,
        "amount_min": 0.5,
        "amount_max": 1.8
      },
      "sensor_noise": {
        "enabled": true,
        "std_min": 0.005,
        "std_max": 0.015
      },
      "aspect_ratio_squeeze": {
        "enabled": true,
        "probability": 0.40,
        "sy_min": 0.75,
        "sy_max": 1.05
      }
    },
    "asymmetric_structural": {
      "clean_rotation_jitter_deg": [-5.0, 5.0],
      "distorted_rotation_deg": [-35.0, -12.0, 12.0, 35.0],
      "distorted_contact_falloff": {
        "enabled": true,
        "probability": 0.30
      }
    }
  },
  "training": {
    "batch_size": 32,
    "num_workers": 0,
    "learning_rate": 0.0001,
    "weight_decay": 0.0001,
    "max_epochs": 25,
    "early_stopping_patience": 6,
    "loss_function": "BCEWithLogitsLoss",
    "pos_weight": 1.0,
    "optimizer": "Adam",
    "threshold_tuning": {
      "min_threshold": 0.01,
      "max_threshold": 0.95,
      "step": 0.01,
      "optimization_metric": "f1"
    }
  },
  "evaluation": {
    "physical_dataset_path": "FingerSure_Dataset",
    "participant_grouped_cv": {
      "n_splits": 7,
      "shuffle": true,
      "seed": 42
    }
  },
  "outputs": {
    "checkpoint_dir": "experiments/classifier_orientation_v3/checkpoints",
    "best_model_filename": "best_model.pth",
    "threshold_filename": "threshold.json",
    "history_filename": "training_history.json",
    "test_results_filename": "test_results.json",
    "confusion_matrix_filename": "test_confusion_matrix.json"
  }
}

